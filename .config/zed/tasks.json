[
  {
    "label": "lazygit",
    "command": "lazygit",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "cwd": "$ZED_WORKTREE_ROOT",
    "hide": "on_success"
  },
  {
    "label": "git: line history",
    "command": "bash /Users/user/.config/zed/scripts/git-line-history.sh",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "reveal_target": "center",
    "cwd": "$ZED_WORKTREE_ROOT",
    "hide": "never"
  }
]
