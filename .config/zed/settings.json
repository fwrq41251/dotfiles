// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "lsp": {
    "metals": {
      "binary": {
        "path": "/Users/user/tools/metals-v2/start-metals-local-java-aosp"
      },
      "initialization_options": {
        "isHttpEnabled": true
      },
      "settings": {
        "startMcpServer": true,
        "googleJavaFormatStyle": "aosp"
      }
    },
    "intellij-server": {
      "settings": {
        "accept_jetbrains_eula": true,
        "eula_hash": "cd82e6cdaf2790f1",
        "server_path": "/Users/user/tools/intellij-lsp-zed/launcher/bin/intellij-server",
        "intellij.dataSharing": "none",
        "intellij.jdkForSymbolResolution": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
      }
    }
  },
  "languages": {
    "Java": {
      "language_servers": ["metals", "!intellij-server", "!jdtls"],
      "formatter": {
        "language_server": {
          "name": "metals"
        }
      },
      "format_on_save": "modifications"
    }
  },
  "which_key": {
    "enabled": true
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "button": false,
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "agent": {
    "button": false,
    "dock": "right",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
    },
    "model_parameters": [],
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "base_keymap": "JetBrains",
  "vim_mode": true,
  "ui_font_size": 15,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Tokyo Night Storm",
  },
  "git": {
    "inline_blame": { "enabled": false },
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
  },
  "title_bar": {
    "show_branch_name": false,
    "show_branch_status_icon": false,
    "show_worktree_name": false,
  },
  "status_bar": {
    "experimental.show": false,
  },
  "format_on_save": "on",
  "code_actions_on_format": {
    // "source.organizeImports": true,
    "source.fixAll": true,
  },
}
