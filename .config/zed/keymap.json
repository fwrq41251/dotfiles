// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "(Workspace && left_dock == GitPanel) > (Editor || GitPanel || Pane)",
    "bindings": {
      "cmd-0": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-`": "workspace::ToggleAllDocks",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-.": "editor::ToggleCodeActions",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
      "ctrl-s": [
        "action::Sequence",
        ["vim::NormalBefore", "workspace::SaveAll"],
      ],
    },
  },
  {
    "context": "Editor && vim_mode == normal && !showing_code_actions && !showing_completions",
    "bindings": {
      "space e": "workspace::ToggleLeftDock",
      "ctrl-s": "workspace::SaveAll",
    },
  },
  {
    "context": "Editor && mode == full && vim_mode == normal && !showing_code_actions && !showing_completions",
    "bindings": {
      //space
      "space space": "file_finder::Toggle",
      "space /": "workspace::NewSearch",
      "space g": [
        "task::Spawn",
        {
          "task_name": "lazygit",
          "reveal_target": "center",
        },
      ],
      //buffers
      "space b o": "pane::CloseOtherItems",
      "space b d": "pane::CloseActiveItem",
      "space s s": "outline::Toggle",
      //goto
      "g t": "editor::GoToTypeDefinition",
      "g r": "editor::FindAllReferences",
      "shift-k": "editor::GoToDefinition",
      //code
      "space c r": "editor::Rename",
      "space c a": "editor::ToggleCodeActions",
      "space c f": "editor::Format",
      //run
      "space r r": "editor::SpawnNearestTask",
      "space d d": "debugger::Start",
      "space d r": "debugger::Rerun",
      "space d b": "editor::ToggleBreakpoint",
      "space d shift-r": "debugger::RerunSession",
      //navigation
      "[ [": "editor::GoToPreviousHunk",
      "] ]": "editor::GoToHunk",
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
      //others
      "f2": "editor::GoToDiagnostic",
    },
  },
  {
    "context": "Editor && mode == full && vim_mode == visual",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
      "/": "workspace::NewSearch",
    },
  },
  {
    "context": "EmptyPane || (ProjectPanel && not_editing)",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space g": ["task::Spawn", { "task_name": "lazygit", "reveal_target": "center" }],
      "space e": "workspace::ToggleLeftDock",
    },
  },
  {
    "bindings": {
      "ctrl-/": "terminal_panel::Toggle",
    },
  },
  {
    "context": "Editor && (edit_prediction && (showing_completions || in_leading_whitespace))",
    "bindings": {
      "alt-l": "editor::AcceptEditPrediction",
    },
  },
]
