// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-`": "workspace::ToggleAllDocks",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-.": "editor::ToggleCodeActions",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
      "ctrl-s": [
        "action::Sequence",
        ["vim::NormalBefore", "workspace::SaveAll"],
      ],
    },
  },
  {
    "context": "CommitDiff > vim_mode == normal",
    "bindings": {
      "g space": "git::OpenFileAtHead",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "ctrl-s": "workspace::SaveAll",
    },
  },
  {
    "context": "(Editor && vim_mode == normal && !showing_code_actions && !showing_completions) || EmptyPane || (ProjectPanel && not_editing)",
    "bindings": {
      "space e": "project_panel::Toggle",
      "space p": "projects::OpenRecent",
    },
  },
  {
    "context": "(Editor && mode == full && vim_mode == normal && !showing_code_actions && !showing_completions) || EmptyPane || (ProjectPanel && not_editing)",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space g g": [
        "task::Spawn",
        { "task_name": "lazygit", "reveal_target": "center" },
      ],
      "space g d": "git::Diff",
      "space g b": "git::Branch",
    },
  },
  {
    "context": "(Editor && mode == full && vim_mode == normal && !showing_code_actions && !showing_completions) || EmptyPane",
    "bindings": {
      "space b o": "pane::CloseOtherItems",
      "space b d": "pane::CloseActiveItem",
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
    },
  },
  {
    "context": "Editor && mode == full && (vim_mode == visual || (vim_mode == normal && !showing_code_actions && !showing_completions))",
    "bindings": {
      "space /": "workspace::NewSearch",
      "space g l": ["task::Spawn", { "task_name": "git: line history" }],
      "space c a": "editor::ToggleCodeActions",
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "Editor && mode == full && vim_mode == normal && !showing_code_actions && !showing_completions",
    "bindings": {
      "space s s": "outline::Toggle",
      //goto
      "g t": "editor::GoToTypeDefinition",
      "g r r": [
        "editor::FindAllReferences",
        { "always_open_multibuffer": false },
      ],
      "g h": "call_hierarchy::ShowIncomingCalls",
      "shift-k": ["editor::GoToDefinition", { "open_results_in": "picker" }],
      //code
      "space c r": "editor::Rename",
      "space c f": "editor::Format",
      "space c i": "editor::GoToImplementation",
      //run
      "space r r": "editor::SpawnNearestTask",
      "space r l": "task::Rerun",
      "space d d": "debugger::Start",
      "space d r": "debugger::Rerun",
      "space d b": "editor::ToggleBreakpoint",
      "space d shift-r": "debugger::RerunSession",
    },
  },
  {
    "bindings": {
      "ctrl-/": "terminal_panel::Toggle",
    },
  },
  {
    "context": "(Editor && vim_mode == normal && !showing_code_actions && !showing_completions) || EmptyPane || (ProjectPanel && not_editing) || (GitPanel && !CommitEditor && !GitBranchSelector && !GitRepositorySelector)",
    "bindings": {
      "space v": "git_panel::ToggleFocus",
    },
  },
  {
    "context": "Editor && (edit_prediction && (showing_completions || in_leading_whitespace))",
    "bindings": {
      "alt-l": "editor::AcceptEditPrediction",
    },
  },
  {
    "context": "(Workspace && left_dock == GitPanel) > ((Editor && vim_mode == normal && !showing_code_actions && !showing_completions) || EmptyPane || (ProjectPanel && not_editing) || (GitPanel && !CommitEditor && !GitBranchSelector && !GitRepositorySelector))",
    "bindings": {
      "space v": "workspace::ToggleLeftDock",
    },
  },
]
