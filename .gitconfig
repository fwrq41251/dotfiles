[core]
	autocrlf = input
	pager = hunk pager
[credential]
	helper = osxkeychain
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	side-by-side = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
[init]
	defaultBranch = main
[pull]
	rebase = true
[include]
	path = ~/.gitconfig.local
