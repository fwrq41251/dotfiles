# Ignore the home directory by default; only expose managed configuration.
/*
!/.gitignore
!/.gitconfig
!/.ideavimrc
!/.p10k.zsh
!/.tmux.conf
!/.wezterm.lua
!/.zprofile
!/.zshenv
!/.zshrc

# Only the listed applications are managed under .config.
!/.config/
/.config/*

!/.config/btop/
/.config/btop/*
!/.config/btop/btop.conf

# Doom configuration files, including new top-level Elisp modules.
!/.config/doom/
/.config/doom/*
!/.config/doom/*.el

# Repository documentation, dependency manifest, scripts, and examples.
!/.config/dotfiles/
/.config/dotfiles/*
!/.config/dotfiles/Brewfile
!/.config/dotfiles/*.md
!/.config/dotfiles/*.sh
!/.config/dotfiles/*.example

!/.config/lazygit/
/.config/lazygit/*
!/.config/lazygit/config.yml

# Neovim: configuration and lockfiles, plus new Lua modules at any depth.
!/.config/nvim/
/.config/nvim/*
!/.config/nvim/.gitignore
!/.config/nvim/.neoconf.json
!/.config/nvim/LICENSE
!/.config/nvim/README.md
!/.config/nvim/init.lua
!/.config/nvim/lazy-lock.json
!/.config/nvim/lazyvim.json
!/.config/nvim/stylua.toml
!/.config/nvim/lua/
/.config/nvim/lua/**
!/.config/nvim/lua/**/
!/.config/nvim/lua/**/*.lua

# Zed databases, conversations, and backups remain excluded.
!/.config/zed/
/.config/zed/*
!/.config/zed/keymap.json
!/.config/zed/settings.json
!/.config/zed/tasks.json

!/.config/zellij/
/.config/zellij/*
!/.config/zellij/config.kdl

# Top-level Hammerspoon scripts; installed Spoons remain excluded.
!/.hammerspoon/
/.hammerspoon/*
!/.hammerspoon/*.lua

# Local overrides and unused templates stay excluded even in allowed folders.
*.local.*
!/.config/dotfiles/zshrc.local.example
/.config/nvim/lua/plugins/example.lua
/.config/nvim/lua/plugins/neotest-java.lua
